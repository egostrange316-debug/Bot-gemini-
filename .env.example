# Local setup only. Never commit a real .env file.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Set this to the exact deployed Supabase function URL.
WEBHOOK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/telegram-bot
# Verify model access with the real key before launch.
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_OUTPUT_TOKENS=4096
# Context memory, not a daily message quota. Oldest pairs are discarded.
HISTORY_TURNS=12
HISTORY_CHAR_LIMIT=48000
# Empty means all private-chat users. Optional comma-separated Telegram user IDs.
ALLOWED_USER_IDS=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the hosted runtime.
